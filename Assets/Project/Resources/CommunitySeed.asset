  - id: seed3
    board: "\uc790\uc720\uac8c\uc2dc\ud310"
    title: "\ub9ac\uc561\ud2b8 \uc0c1\ud0dc \uad00\ub9ac \uc9c8\ubb38\uc788\uc2b5\ub2c8\ub2e4"
    body: "\ub2e4\ub4e4 \uc0c1\ud0dc \uad00\ub9ac \ub77c\uc774\ube0c\ub7ec\ub9ac\ub85c \uc5b4\ub5a4 \uac78 \uc8fc\ub85c \uc0ac\uc6a9\ud558\uc2dc\ub098\uc694? \uc694\uc998 Zustand\uac00 \uc778\uae30 \ub9ce\ub358\ub370 \ub3c4\uc785\ud574\ubcfc\uae4c \uace0\ubbfc\uc911\uc785\ub2c8\ub2e4. \uae34 \ub0b4\uc6a9\uc744 \uc801\uc5b4\ub3c4 \ub9ac\uc2a4\ud2b8\uc5d0\uc11c\ub294 \uc0dd\ub7b5\ub418\uace0 \uc0c1\uc138 \ud398\uc774\uc9c0\uc5d0\uc11c \ubaa8\ub450 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
    author: dodoriruu7_1
