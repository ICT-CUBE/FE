      m_Calls: []
  m_text: "\uC791\uB144 \uD31D\uC5C5\uC2A4\uD1A0\uC5B4\uC5D0\uC11C \uAD6C\uB9E4\uD55C
    \uC81C\uB2C8 \uC194\uB85C \uD050\uBE0C \uC591\uB3C4\uD569\uB2C8\uB2E4.\n\uC18C\uC7A5\uC6A9\uC73C\uB85C
    \uBCF4\uAD00\uB9CC \uD574\uC11C \uAE30\uC2A4\uB098 \uCC0D\uD798 \uC804\uD600
    \uC5C6\uB294 S\uAE09 \uC0C8\uC0C1\uD488 \uCEE8\uB514\uC158\uC785\uB2C8\uB2E4.\n\n\uBCF4\uC99D\uC11C,
    \uC624\uB9AC\uC9C0\uB110 \uBC15\uC2A4 \uBAA8\uB450 \uD3EC\uD568\uB41C \uD480\uBC15\uC2A4
    \uAD6C\uC131\uC785\uB2C8\uB2E4.\n\uC548\uC804\uACB0\uC81C(\uC5D0\uC2A4\uD06C\uB85C)
    \uAC70\uB798\uB9CC \uC9C4\uD589\uD569\uB2C8\uB2E4!\n\n\uC2E4\uBB3C \uC0C1\uD0DC
    \uC0AC\uC9C4 \uC5EC\uB7EC\uC7A5 \uCCA8\uBD80\uD588\uC73C\uB2C8 \uAF3C\uAF3C\uD788
    \uD655\uC778\uD574\uC8FC\uC138\uC694 :)\n\uCFE8\uAC70\uB798\uC2DC \uBC30\uC1A1\uBE44
    \uD3EC\uD568\uD574\uB4DC\uB9BD\uB2C8\uB2E4. \uAD81\uAE08\uD55C \uC810 \uD3B8\uD558\uAC8C
    \uBB38\uC758\uC8FC\uC138\uC694!"
